---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import VineCorners from '../../components/VineCorners.astro';
import Marginalia from '../../components/Marginalia.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getSortedPosts, readingTimeMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null, // sorted desc: index - 1 is newer
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body ?? '');
---

<BaseLayout title={post.data.title} scene="blog" description={post.data.description}>
  <Window title={`Grimoire — ${post.data.title}`} icon="tome" x={230} y={16} width={760} frame="arch" trim="azurite" class="tome vined">
    <VineCorners />
    <Marginalia top={9} />
    <article class="dropcap">
      <header class="tome-header">
        <p class="tome-meta">
          <FormattedDate date={post.data.pubDate} />
          {post.data.lang && <span class="lang-rune">{post.data.lang}</span>}
          <span aria-hidden="true">·</span>
          <span>{minutes} min read by candlelight</span>
        </p>
        <h1 class="tome-title heading-moon-gold">{post.data.title}</h1>
        {post.data.description && <p class="lede">{post.data.description}</p>}
      </header>

      <div class="prose">
        <Content />
      </div>

      {(newer || older) && (
        <nav class="scroll-nav" aria-label="Scroll navigation">
          {newer ? (
            <a class="pixel-btn" href={`/blog/${newer.id}/`}>◀ newer scroll</a>
          ) : (
            <span />
          )}
          {older ? (
            <a class="pixel-btn" href={`/blog/${older.id}/`}>older scroll ▶</a>
          ) : (
            <span />
          )}
        </nav>
      )}
    </article>
  </Window>
</BaseLayout>

<style>
  .tome-header {
    padding-bottom: 1rem;
    border-bottom: 2px dashed var(--bevel-dark);
  }

  .tome-meta {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .lang-rune {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    background: var(--indigo);
    color: var(--gold-bright);
    padding: 0 5px;
    border: 1px solid var(--ink);
  }

  .tome-title {
    font-size: var(--text-3xl);
    margin: 0.4rem 0 0.6rem;
    max-width: 26ch;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: 55ch;
  }

  /* rendered Markdown on parchment */
  .prose {
    max-width: 68ch;
    margin-top: 1rem;
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    margin-top: 1.6rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.2rem;
    border-bottom: 3px double var(--gold);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    margin-top: 1.2rem;
    margin-bottom: 0.3rem;
  }

  .prose :global(p) {
    margin-block: 0.7rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 0.7rem;
    padding-inline-start: 1.5rem;
  }

  .prose :global(li::marker) {
    color: var(--ember-deep);
  }

  .prose :global(a) {
    color: var(--ember-deep);
  }

  .prose :global(code) {
    font-family: var(--font-body);
    font-size: 1.05rem;
    background: var(--stone-dark);
    color: var(--magic);
    padding: 0.05em 0.35em;
    border: 1px solid var(--ink);
  }

  .prose :global(pre) {
    background: #0a0810;
    border: 2px solid var(--ink);
    box-shadow: inset 2px 2px 0 rgb(0 0 0 / 0.6);
    padding: 0.8rem;
    overflow-x: auto;
    margin-block: 0.8rem;
  }

  .prose :global(pre code) {
    background: none;
    border: 0;
    color: var(--magic);
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--gold);
    padding-left: 1rem;
    margin-block: 0.8rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .prose :global(img) {
    border: 2px solid var(--ink);
    box-shadow: 0 0 0 3px var(--gold);
    margin-block: 1rem;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 2px dashed var(--bevel-dark);
    margin-block: 1.4rem;
  }

  .scroll-nav {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 1.6rem;
    padding-top: 1rem;
    border-top: 2px dashed var(--bevel-dark);
  }
</style>
