---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import SectionBanner from '../../components/SectionBanner.astro';
import PageFooter from '../../components/PageFooter.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const pieces = (await getCollection('art')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Art" description="The Jester's Gallery — illustrations, studies, and sketches of the realm.">
  <Window title="The Jester's Gallery — art & studies" icon="jester" x={230} y={16} width={760} class="gallery ffix grain-paper">
    <SectionBanner text="Gallery" sub="the jester hangs what the brush has wrought" dither />
    <header class="gallery-header">
      <p class="ui-label">
        {pieces.length > 0
          ? `${pieces.length} ${pieces.length === 1 ? 'piece' : 'pieces'} hung, newest first.`
          : 'the walls are bare — new work is on the easel.'}
      </p>
    </header>
    <hr class="scroll-divider" />

    {pieces.length === 0 ? (
      <p>The gallery stands empty — the jester is painting as we speak.</p>
    ) : (
      <div class="walls">
        {pieces.map(({ data }) => (
          <figure class="framed">
            <img
              src={data.image.replace(/\/600\/\d+$/, '/300/375')}
              alt={data.description ?? data.title}
              width="300"
              height="375"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="piece-title">{data.title}</span>
              <span class="piece-meta">
                <FormattedDate date={data.date} />
                {data.tags.length > 0 && <span> · {data.tags.join(' / ')}</span>}
              </span>
              {data.description && <span class="piece-desc">{data.description}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
    <PageFooter updated="1 Sep 2026" />
  </Window>
</BaseLayout>

<style>
  .gallery-header .ui-label {
    margin-top: 0.2rem;
  }

  /* masonry walls */
  .walls {
    columns: 1;
    column-gap: 1.2rem;
  }

  .framed {
    break-inside: avoid;
    margin: 0 0 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .framed img {
    width: 100%;
    height: auto;
    border: 3px solid var(--gold);
    outline: 2px solid var(--ink);
    box-shadow: 4px 4px 0 rgb(0 0 0 / 0.35);
    image-rendering: pixelated;
    transition: transform 120ms steps(2, end);
  }

  .framed:hover img {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 rgb(0 0 0 / 0.35);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--parchment-aged);
    border: 2px solid var(--ink);
    box-shadow: inset 1px 1px 0 var(--bevel-dark);
    padding: 0.35rem 0.6rem;
  }

  .piece-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ink);
  }

  .framed:hover .piece-title {
    color: var(--ember-deep);
  }

  .piece-meta {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }

  .piece-desc {
    font-size: 1rem;
    color: var(--ink-soft);
  }

  @media (min-width: 40rem) {
    .walls { columns: 2; }
  }

  @media (min-width: 64rem) {
    .walls { columns: 3; }
  }
</style>
