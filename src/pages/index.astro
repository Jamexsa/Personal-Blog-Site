---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import Badge88 from '../components/Badge88.astro';
import PixelIcon from '../components/PixelIcon.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getSortedPosts } from '../lib/posts';

const posts = await getSortedPosts();
const recent = posts.slice(0, 3);
---

<BaseLayout title="Your Name" description="Game developer and artist of the realm — games, art, and the devlog grimoire.">
  <Window title="Hail, Traveler — the keep of YOUR NAME" icon="castle" x={230} y={16} width={520} class="welcome">
    <p class="kicker">game dev · artist · keeper of small weird worlds</p>
    <h1 class="wordmark">Your Name</h1>
    <p class="intro">
      I craft <span class="ember">small games</span> and paint the worlds they
      live in. This keep holds my deeds, my art, and the grimoire where the
      making of it all is written down.
    </p>
    <div class="welcome-actions">
      <a class="pixel-btn" href="/games/"><PixelIcon name="shield" size={14} /> View my deeds</a>
      <a class="pixel-btn" href="/blog/"><PixelIcon name="tome" size={14} /> Read the grimoire</a>
    </div>
  </Window>

  <Window title="The Bard's music box" icon="lute" x={790} y={16} width={300} class="musicbox">
    <div class="lcd lcd-display">
      <span>♪ NOW PLAYING</span>
      <span class="track">lute core — disc 03</span>
    </div>
    <div class="eq" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <p class="mb-note">the bard is on a break — the lute hums to itself</p>
  </Window>

  <Window title="Guest ledger" icon="raven" x={230} y={430} width={260} class="ledger">
    <div class="lcd lcd-counter">GUESTS: 00427</div>
    <p class="ledger-note">thy visit hath been recorded in the ledger of the realm.</p>
  </Window>

  <Window title="Chronicle — latest from the Grimoire" icon="tome" x={515} y={430} width={330} class="chronicle">
    {recent.length > 0 ? (
      <ul class="chronicle-list">
        {recent.map(({ id, data }, i) => (
          <li>
            <FormattedDate date={data.pubDate} />
            <a href={`/blog/${id}/`}>{data.title}</a>
            {i === 0 && <span class="new">NEW</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="ledger-note">the chronicle awaits its first entry…</p>
    )}
    <hr class="scroll-divider" />
    <a class="pixel-btn small" href="/blog/">Read all entries</a>
  </Window>

  <Window title="Banners of the realm" icon="banner" x={875} y={430} width={215} class="banners">
    <div class="banner-row">
      <Badge88 label="Made with Astro" field="#1d1733" charge="#e8c558" pattern="diaper" />
      <Badge88 label="Game Dev" field="#c23a1e" charge="#f4ead0" pattern="paly" />
      <Badge88 label="Est. 2026" field="#2a2118" charge="#7fe07f" pattern="plain" />
    </div>
    <p class="ledger-note">best viewed by candlelight, 800×600</p>
  </Window>
</BaseLayout>

<style>
  /* welcome */
  .kicker {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    text-transform: lowercase;
  }

  .wordmark {
    font-size: var(--text-display);
    margin: 0.2rem 0 0.4rem;
    color: var(--ink);
  }

  .ember {
    color: var(--ember-deep);
  }

  .intro {
    font-size: var(--text-lg);
    max-width: 52ch;
  }

  .welcome-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 1rem;
  }

  /* music box */
  .lcd-display {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 1.1rem;
  }

  .lcd-display .track {
    color: var(--gold-bright);
    text-shadow: 0 0 6px rgb(232 197 88 / 0.4);
  }

  .eq {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 28px;
    margin-top: 10px;
  }

  .eq span {
    width: 8px;
    background: var(--gold);
    border: 1px solid var(--ink);
    animation: eqbounce 0.9s steps(3, end) infinite alternate;
  }

  .eq span:nth-child(1) { animation-delay: 0s; }
  .eq span:nth-child(2) { animation-delay: 0.15s; }
  .eq span:nth-child(3) { animation-delay: 0.3s; }
  .eq span:nth-child(4) { animation-delay: 0.1s; }
  .eq span:nth-child(5) { animation-delay: 0.25s; }

  @keyframes eqbounce {
    from { height: 6px; }
    to { height: 26px; }
  }

  .mb-note,
  .ledger-note {
    margin-top: 8px;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  /* ledger */
  .ledger .lcd-counter {
    font-size: 1.3rem;
    letter-spacing: 0.12em;
  }

  /* chronicle */
  .chronicle-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chronicle-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chronicle-list a {
    color: var(--ink);
  }

  .chronicle-list a:hover {
    color: var(--ember-deep);
  }

  .new {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--ember);
    color: var(--parchment);
    padding: 0 6px;
    border: 1px solid var(--ink);
    animation: newblink 1.2s steps(2, end) infinite;
  }

  @keyframes newblink {
    50% { opacity: 0.55; }
  }

  .pixel-btn.small {
    font-size: 0.9rem;
    padding: 0.15rem 0.6rem;
  }

  /* banners */
  .banner-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
