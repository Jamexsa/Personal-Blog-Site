---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import SectionBanner from '../../components/SectionBanner.astro';
import PageFooter from '../../components/PageFooter.astro';
import Badge88 from '../../components/Badge88.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import { socials } from '../../components/socials';

const games = await getCollection('games');
const atTheForge = games
  .filter(({ data }) => data.status === 'in-development')
  .sort(
    (a, b) =>
      (b.data.releaseDate?.valueOf() ?? 0) - (a.data.releaseDate?.valueOf() ?? 0)
  )[0];

const identityPlaques = [
  'speaks: EN · IT',
  'realm: your homeland',
  'trade: game dev & pixel art',
  'alignment: small weird worlds',
];

const interests = [
  '#game-feel',
  '#palettes-with-dirt-on-them',
  '#PSX-era-3D',
  '#handheld-consoles',
  '#roguelikes-with-feelings',
  '#tabletop-maps',
  '#analog-horror',
  '#finishing-the-ugly-version',
];

// Original pixel pairs — our own likes/dislikes showcase.
const versus = [
  { likeIcon: 'moon', likeLabel: 'night owl', dislikeIcon: 'star', dislikeLabel: 'morning person' },
  { likeIcon: 'tankard', likeLabel: 'mead', dislikeIcon: 'note', dislikeLabel: 'loud taverns' },
  { likeIcon: 'chest', likeLabel: 'secret rooms', dislikeIcon: 'bag', dislikeLabel: 'inventory Tetris' },
  { likeIcon: 'castle', likeLabel: 'cozy keeps', dislikeIcon: 'raven', dislikeLabel: 'fetch quests' },
] as const;

const chronicle = [
  { version: 'v1.1', date: 'Sep 2026', note: 'the new wings open — diary, reliquary, radio, workshop, stock, ledger' },
  { version: 'v1.0', date: 'Aug 2026', note: 'the keep rebuilt in stone and parchment (KingdomOS redesign)' },
  { version: 'v0.1', date: 'Jul 2026', note: 'first foundation stones — a sober blog on a clean grid' },
] as const;

// Heraldry exchange — the snippet allies can copy to fly this banner.
const bannerHref = 'https://your-name.pages.dev/';
const bannerSnippet = `<a href="${bannerHref}"><img src="${bannerHref}banner-88x31.gif" alt="Your Name — game dev & artist" width="88" height="31"></a>`;
---

<BaseLayout
  title="About"
  description="The Bard's tale — who I am, what I make, how this keep is built, and how to send a raven."
>
  <Window title="The Bard's Tale — about the author" icon="lute" x={230} y={16} width={640} class="bard">
    <SectionBanner text="The Bard" sub="the webmaster, the squire, and the knight are all the same person" frame="cartouche" />

    <section class="bio" aria-label="About the author">
      <img
        class="portrait"
        src="https://picsum.photos/seed/portrait/240/280"
        alt="Portrait placeholder"
        width="240"
        height="280"
        loading="lazy"
        decoding="async"
      />
      <div class="bio-text">
        <h1 class="bio-title">Hail, I'm Your Name.</h1>
        <ul class="plaque-row" aria-label="Identity plaques">
          {identityPlaques.map((p, i) => (
            <li class:list={['plaque', { party: i % 2 === 0 }]}>{p}</li>
          ))}
        </ul>
        <p>
          Placeholder tale: an independent game developer and artist making
          small, weird games about places and the feelings they hold. By day a
          wanderer of engines; by night a painter of small worlds by
          candlelight.
        </p>
        <p>
          I care about game feel, restrained palettes, and finishing the ugly
          version first. The Grimoire on this site is where the process is
          written down — the wins, the detours, and the placeholder rectangles
          that became final art.
        </p>
        {atTheForge && (
          <p class="currently">
            <span class="banner-tag forge">AT THE FORGE</span>
            <span>{atTheForge.data.title} — {atTheForge.data.description ?? 'a new deed takes shape.'}</span>
          </p>
        )}
      </div>
    </section>

    <hr class="scroll-divider big" />

    <section class="interests" aria-label="Interests">
      <h2 class="ws-title"><PixelIcon name="star" size={16} /> My favorite things</h2>
      <p class="ui-label">interests, affixed like billets to the board:</p>
      <ul class="interest-list">
        {interests.map((tag) => (
          <li class="plaque interest">{tag}</li>
        ))}
      </ul>

      <h3 class="ws-sub">The ledger of small preferences</h3>
      <p class="ui-label">likes on the left, grievances on the right — pixel heraldry, all our own:</p>
      <div class="versus-grid">
        {versus.map(({ likeIcon, likeLabel, dislikeIcon, dislikeLabel }) => (
          <div class="versus-pair">
            <p class="v-side like">
              <PixelIcon name={likeIcon} size={16} />
              <span>{likeLabel}</span>
            </p>
            <span class="v-vs" aria-hidden="true">vs</span>
            <p class="v-side dislike">
              <PixelIcon name={dislikeIcon} size={16} />
              <span>{dislikeLabel}</span>
            </p>
          </div>
        ))}
      </div>
    </section>

    <hr class="scroll-divider big" />

    <section class="kingdom" aria-label="About this website">
      <h2 class="ws-title"><PixelIcon name="castle" size={16} /> About this kingdom</h2>
      <p>
        This keep is a hand-built thing: <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> for
        the timber, open pixel fonts for the voice, and one global stylesheet
        of parchment, gold, and ember. The windows drag, the crier crieth, and
        the CRT scanlines are lovingly fake.
      </p>
      <p>
        It stands on the shoulders of the vintage personal-homepage tradition —
        draggable windows, guestbooks, shrines, 88×31 banners — with a nod of
        respect to the modern makers keeping that fire lit. Every pixel on
        this site is original work.
      </p>

      <h3 class="ws-sub">Chronicle of the keep</h3>
      <ul class="chronicle">
        {chronicle.map(({ version, date, note }) => (
          <li>
            <span class="plaque ver">{version}</span>
            <span class="chron-date">{date}</span>
            <span class="chron-note">{note}</span>
          </li>
        ))}
      </ul>
    </section>

    <hr class="scroll-divider big" />

    <section class="heraldry" aria-label="Banner exchange">
      <h2 class="ws-title"><PixelIcon name="banner" size={16} /> Heraldry exchange</h2>
      <p class="ui-label">fly my banner at thy keep — trade is welcome:</p>
      <div class="exchange">
        <div class="our-banner">
          <Badge88 label="Your Name · Game Dev" field="#1d1733" charge="#e8c558" pattern="diaper" />
          <p class="ui-label small-note">88×31 — drawn by this realm's hand</p>
        </div>
        <div class="snippet">
          <label class="ui-label" for="banner-snippet">the linking rune:</label>
          <textarea id="banner-snippet" readonly rows="3" spellcheck="false">{bannerSnippet}</textarea>
          <button class="pixel-btn small" type="button" data-copy-banner>
            copy the rune
          </button>
          <p class="ui-label small-note" data-banner-note aria-live="polite">(swap the .gif for the real banner once it is drawn)</p>
        </div>
      </div>
    </section>

    <section class="ravenpost">
      <h2>Send a raven</h2>
      <p class="ui-label">
        For inquiries, jam invitations, or palette talk:
        <a href="mailto:hello@example.com">hello@example.com</a> (placeholder).
      </p>
      <ul class="raven-list">
        {socials.map(({ label, href }) => (
          <li>
            <a class="pixel-btn" href={href}>
              <PixelIcon name="raven" size={14} />
              {label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <PageFooter updated="1 Sep 2026" />
  </Window>
</BaseLayout>

<style>
  .ws-title {
    font-size: var(--text-2xl);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ws-sub {
    font-size: var(--text-xl);
    margin-top: 1.1rem;
  }

  .scroll-divider.big {
    margin-block: 1.4rem;
  }

  /* bio */
  .bio {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin-top: 0.4rem;
  }

  .portrait {
    width: 100%;
    max-width: 240px;
    border: 3px solid var(--gold);
    outline: 2px solid var(--ink);
    image-rendering: pixelated;
  }

  .bio-title {
    font-size: var(--text-3xl);
  }

  .plaque-row {
    list-style: none;
    margin: 0.4rem 0 0.8rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .plaque-row .plaque {
    font-size: 0.8rem;
  }

  .bio-text p {
    margin-block: 0.6rem;
    max-width: 58ch;
  }

  .currently {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 2px dashed var(--bevel-dark);
  }

  .banner-tag {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 1px 8px;
    border: 1px solid var(--ink);
    color: var(--parchment);
    background: var(--ember);
    animation: forgeblink 1.4s steps(2, end) infinite;
  }

  @keyframes forgeblink {
    50% { opacity: 0.6; }
  }

  /* interests */
  .interest-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .interest {
    font-size: 0.9rem;
    background: var(--indigo);
    color: var(--gold-bright);
    border-color: var(--ink);
  }

  .versus-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .versus-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    background: var(--parchment-aged);
    border: 2px solid var(--ink);
    box-shadow: inset 2px 2px 0 var(--bevel-dark), inset -2px -2px 0 var(--bevel-light);
    padding: 0.45rem 0.7rem;
  }

  .v-side {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    margin: 0;
    padding-left: 0.3rem;
    border-left: 3px solid var(--azurite);
  }

  .v-side.like {
    color: var(--ink);
  }

  .v-side.dislike {
    color: var(--ink-soft);
    flex-direction: row-reverse;
    text-align: right;
    padding-left: 0;
    padding-right: 0.3rem;
    border-left: 0;
    border-right: 3px solid var(--brazilwood);
  }

  .v-side.dislike :global(.pixel-icon) {
    opacity: 0.55;
    filter: grayscale(1);
  }

  .v-vs {
    font-family: var(--font-display);
    color: var(--ember-deep);
    font-size: 1.1rem;
  }

  /* kingdom / chronicle */
  .kingdom p {
    max-width: 62ch;
    margin-block: 0.6rem;
    color: var(--ink-soft);
  }

  .kingdom p a {
    color: var(--ember-deep);
  }

  .chronicle {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .chronicle li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .plaque.ver {
    font-size: 0.75rem;
    background: var(--indigo);
    color: var(--gold-bright);
  }

  .chron-date {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .chron-note {
    flex: 1;
    min-width: 16rem;
  }

  /* heraldry exchange */
  .exchange {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 0.7rem;
  }

  .our-banner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .snippet {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }

  .snippet textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    background: var(--night-deep);
    color: var(--magic);
    border: 2px solid var(--ink);
    box-shadow: inset 2px 2px 0 rgb(0 0 0 / 0.6);
    padding: 0.4rem 0.5rem;
    resize: vertical;
  }

  .small-note {
    font-size: 0.85rem;
  }

  /* raven post */
  .ravenpost {
    margin-top: 1.6rem;
    padding-top: 1rem;
    border-top: 3px double var(--gold);
  }

  .ravenpost h2 {
    font-size: var(--text-2xl);
    margin-bottom: 0.4rem;
  }

  .raven-list {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (min-width: 48rem) {
    .bio {
      grid-template-columns: minmax(11rem, 15rem) 1fr;
      gap: 1.6rem;
    }

    .versus-grid {
      grid-template-columns: 1fr 1fr;
    }

    .exchange {
      grid-template-columns: auto 1fr;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-banner]');
  const area = document.querySelector<HTMLTextAreaElement>('#banner-snippet');
  const note = document.querySelector<HTMLElement>('[data-banner-note]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(area?.value ?? '');
      if (note) note.textContent = 'the rune is copied — fly it well.';
    } catch {
      if (note) note.textContent = 'the scribe could not copy — select the rune by hand.';
    }
  });
</script>
