---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import SectionBanner from '../../components/SectionBanner.astro';
import PageFooter from '../../components/PageFooter.astro';

const shrines = (await getCollection('shrines')).sort(
  (a, b) => a.data.order - b.data.order
);
const complete = shrines.filter(({ data }) => data.status === 'complete');
const sealed = shrines.filter(({ data }) => data.status === 'sealed');
---

<BaseLayout
  title="Shrines"
  scene="shrines"
  description="The Reliquary — fan shrines for the games, films, and books this realm holds dear."
>
  <Window title="The Reliquary — fan shrines" shortTitle="Reliquary" icon="chest" x={230} y={16} width={760} frame="scroll" trim="verdigris" class="reliquary">
    <SectionBanner
      text="Reliquary"
      sub="small temples for the things that shaped the realm"
      frame="cartouche"
      wing="wanderer"
    />

    <p class="ui-label">
      {complete.length > 0
        ? `${complete.length} consecrated · ${sealed.length} still sealed.`
        : 'the reliquary awaits its first relic.'}
    </p>
    <hr class="scroll-divider" />

    {complete.length === 0 && sealed.length === 0 ? (
      <p class="empty">No relics gathered yet — the reliquary echoes.</p>
    ) : (
      <div class="shrine-grid">
        {shrines.map(({ id, data }) =>
          data.status === 'complete' ? (
            <a class="shrine-card" href={`/shrines/${id}/`}>
              {data.cover && (
                <img
                  class="shrine-cover"
                  src={data.cover.replace(/\/480\/300$/, '/240/150')}
                  alt={`Relic cover for ${data.title}`}
                  width="240"
                  height="150"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="shrine-main">
                <p class="shrine-meta">
                  <span class="plaque medium">{data.medium}</span>
                  <span class="lit">✦ consecrated</span>
                </p>
                <h2 class="shrine-title">{data.title}</h2>
                <p class="shrine-blurb">{data.blurb}</p>
              </div>
            </a>
          ) : (
            <div class="shrine-card sealed" aria-label={`${data.title} — sealed reliquary`}>
              {data.cover && (
                <img
                  class="shrine-cover"
                  src={data.cover.replace(/\/480\/300$/, '/240/150')}
                  alt=""
                  width="240"
                  height="150"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="shrine-main">
                <p class="shrine-meta">
                  <span class="plaque medium">{data.medium}</span>
                  <span class="sealed-tag">🔒 sealed</span>
                </p>
                <h2 class="shrine-title">{data.title}</h2>
                <p class="shrine-blurb">{data.blurb}</p>
                <div class="construction" aria-hidden="true">
                  <svg
                    class="construction-scene"
                    width="72"
                    height="40"
                    viewBox="0 0 18 10"
                    shape-rendering="crispEdges"
                  >
                    <!-- scaffold frame -->
                    <rect x="1" y="1" width="1" height="8" fill="#574733" />
                    <rect x="1" y="1" width="11" height="1" fill="#574733" />
                    <rect x="11" y="1" width="1" height="8" fill="#574733" />
                    <rect x="1" y="4" width="11" height="1" fill="#574733" />
                    <rect x="1" y="8" width="11" height="1" fill="#574733" />
                    <!-- diagonal brace -->
                    <rect x="3" y="2" width="1" height="1" fill="#a06a2a" />
                    <rect x="4" y="3" width="1" height="1" fill="#a06a2a" />
                    <rect x="5" y="4" width="1" height="1" fill="#a06a2a" />
                    <!-- tiny worker on the platform -->
                    <rect x="7" y="6" width="2" height="2" fill="#2a4d8f" />
                    <rect x="7" y="5" width="2" height="1" fill="#e9d8a6" />
                    <rect x="9" y="6" width="2" height="1" fill="#9b2335" />
                    <!-- hammer spark -->
                    <rect x="11" y="5" width="1" height="1" fill="#e8c558" />
                    <!-- hanging lantern -->
                    <rect x="13" y="2" width="1" height="1" fill="#574733" />
                    <rect x="13" y="3" width="1" height="1" fill="#ff5a36" />
                  </svg>
                  <p class="construction-note">relics under construction — visit again, traveler</p>
                </div>
              </div>
            </div>
          )
        )}
      </div>
    )}

    <PageFooter updated="1 Sep 2026" />
  </Window>
</BaseLayout>

<style>
  .empty {
    color: var(--ink-soft);
  }

  .shrine-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }

  .shrine-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    background: var(--parchment-aged);
    border: 2px solid var(--ink);
    box-shadow: inset 2px 2px 0 var(--bevel-dark), inset -2px -2px 0 var(--bevel-light);
    padding: 0.9rem;
    text-decoration: none;
    transition: transform 120ms steps(2, end);
  }

  a.shrine-card:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      inset 2px 2px 0 var(--bevel-dark),
      inset -2px -2px 0 var(--bevel-light),
      4px 4px 0 rgb(0 0 0 / 0.35);
  }

  .shrine-card.sealed {
    opacity: 0.75;
  }

  .shrine-cover {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border: 2px solid var(--ink);
    box-shadow: 0 0 0 2px var(--gold);
    image-rendering: pixelated;
    filter: saturate(0.9);
  }

  .sealed .shrine-cover {
    filter: grayscale(0.7) brightness(0.8);
  }

  .shrine-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }

  .plaque.medium {
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .lit {
    color: var(--gold);
    letter-spacing: 0.06em;
  }

  .sealed-tag {
    color: var(--ink-soft);
    letter-spacing: 0.06em;
  }

  .shrine-title {
    font-size: var(--text-2xl);
    color: var(--ink);
    margin-top: 0.25rem;
  }

  a.shrine-card:hover .shrine-title {
    color: var(--ember-deep);
  }

  .shrine-blurb {
    color: var(--ink-soft);
    max-width: 55ch;
    margin-top: 0.2rem;
  }

  .sealed-note {
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  .construction {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 0.6rem;
    padding: 0.5rem 0.6rem;
    background: var(--parchment);
    border: 2px dashed var(--bevel-dark);
  }

  .construction-scene {
    flex: none;
    image-rendering: pixelated;
  }

  .construction-note {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
    animation: constructblink 2s steps(2, end) infinite;
  }

  @keyframes constructblink {
    50% { opacity: 0.55; }
  }

  @media (min-width: 48rem) {
    .shrine-grid {
      grid-template-columns: 1fr 1fr;
    }

    .shrine-card {
      grid-template-columns: 1fr;
      align-content: start;
    }
  }
</style>
