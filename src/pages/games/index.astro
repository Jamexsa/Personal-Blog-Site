---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Undated (in-development/prototype) entries first, then by release date desc.
const games = (await getCollection('games')).sort((a, b) => {
  const ad = a.data.releaseDate?.valueOf() ?? Number.POSITIVE_INFINITY;
  const bd = b.data.releaseDate?.valueOf() ?? Number.POSITIVE_INFINITY;
  return bd - ad;
});

const statusLabel: Record<string, string> = {
  'in-development': 'In development',
  prototype: 'Prototype',
};
---

<BaseLayout title="Games" description="Games and experiments — released titles, work in progress, and prototypes.">
  <header class="page-header">
    <p class="font-mono-label">Portfolio</p>
    <h1>Games &amp; experiments</h1>
    <p class="text-muted">
      {games.length > 0 ? `${games.length} ${games.length === 1 ? 'project' : 'projects'}, shipped and in progress.` : 'Nothing here yet — prototypes in progress.'}
    </p>
  </header>

  {games.length === 0 ? (
    <p class="text-muted">Nothing shipped yet — a few prototypes are quietly cooking.</p>
  ) : (
    <ul class="game-grid">
      {games.map(({ data }) => {
        const href = data.url ?? '#';
        const isExternal = Boolean(data.url);
        const host = isExternal ? new URL(data.url!).hostname.replace('www.', '') : '';
        return (
          <li>
            <a
              class="game-card"
              href={href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
              aria-label={isExternal ? `${data.title} — opens on ${host}` : data.title}
            >
              {data.cover ? (
                <img
                  class="game-cover"
                  src={data.cover}
                  alt={`Cover art for ${data.title}`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="game-cover game-cover-empty" aria-hidden="true"></div>
              )}
              <div class="game-body">
                <p class="game-meta font-mono-label">
                  <span>{data.releaseDate ? data.releaseDate.getFullYear() : statusLabel[data.status] ?? ''}</span>
                  {data.status !== 'released' && data.releaseDate && <span>{statusLabel[data.status]}</span>}
                </p>
                <h2 class="game-title">{data.title}</h2>
                {data.description && <p class="game-desc text-muted">{data.description}</p>}
                {data.tags.length > 0 && (
                  <ul class="game-tags" aria-label="Tags">
                    {data.tags.map((tag) => (
                      <li class="tag font-mono-label">{tag}</li>
                    ))}
                  </ul>
                )}
                {isExternal && <span class="game-link font-mono-label">{host} ↗</span>}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>

<style>
  .page-header {
    margin-block: var(--space-4) var(--space-8);
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    margin-block: var(--space-2) var(--space-3);
  }

  .game-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: var(--space-6) var(--space-5);
  }

  .game-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    transition: transform 150ms ease;
  }

  .game-card:hover {
    transform: translateY(-3px);
  }

  .game-cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
  }

  .game-cover-empty {
    background:
      linear-gradient(135deg, var(--color-accent-soft), transparent 60%),
      var(--color-surface);
  }

  .game-card:hover .game-cover {
    box-shadow: var(--shadow-md);
  }

  .game-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .game-meta {
    display: flex;
    gap: var(--space-3);
  }

  .game-title {
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .game-card:hover .game-title {
    color: var(--color-accent);
  }

  .game-desc {
    font-size: var(--text-sm);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .game-tags {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--color-accent-strong);
    background-color: var(--color-accent-soft);
    border-radius: 999px;
    padding: 0.15em 0.7em;
  }

  .game-link {
    color: var(--color-text-muted);
  }

  .game-card:hover .game-link {
    color: var(--color-accent);
  }
</style>
