---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import SectionBanner from '../../components/SectionBanner.astro';
import PageFooter from '../../components/PageFooter.astro';
import { getCollection } from 'astro:content';

// Undated (in-development/prototype) entries first, then by release date desc.
const games = (await getCollection('games')).sort((a, b) => {
  const ad = a.data.releaseDate?.valueOf() ?? Number.POSITIVE_INFINITY;
  const bd = b.data.releaseDate?.valueOf() ?? Number.POSITIVE_INFINITY;
  return bd - ad;
});

const statusBanner: Record<string, { label: string; class: string }> = {
  released: { label: 'DEED DONE', class: 'done' },
  'in-development': { label: 'AT THE FORGE', class: 'forge' },
  prototype: { label: 'ON PARCHMENT', class: 'rumor' },
};
---

<BaseLayout title="Games" description="Deeds of the Knight — released games, works at the forge, and prototypes.">
  <Window title="Deeds of the Knight — games & experiments" icon="shield" x={230} y={16} width={760} class="deeds ffix grain-paper">
    <SectionBanner text="Deeds" sub="the heralds' rolls — released, forged, and rumored" dither />
    <header class="deeds-header">
      <p class="ui-label">
        {games.length > 0
          ? `${games.length} ${games.length === 1 ? 'deed' : 'deeds'} recorded in the heralds' rolls.`
          : 'no deeds recorded — the knight rides yet.'}
      </p>
    </header>
    <hr class="scroll-divider" />

    {games.length === 0 ? (
      <p>Nothing hangs in the hall yet — a few prototypes are being forged in secret.</p>
    ) : (
      <ul class="deed-list">
        {games.map(({ data }) => {
          const banner = statusBanner[data.status] ?? statusBanner.released;
          const isExternal = Boolean(data.url);
          const host = isExternal ? new URL(data.url!).hostname.replace('www.', '') : '';
          return (
            <li class="deed">
              {data.cover ? (
                <img
                  class="deed-cover"
                  src={data.cover.replace(/\/800\/500$/, '/240/150')}
                  alt={`Cover art for ${data.title}`}
                  width="240"
                  height="150"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="deed-cover deed-cover-empty" aria-hidden="true"></div>
              )}
              <div class="deed-main">
                <p class="deed-meta">
                  <span class={`banner-tag ${banner.class}`}>{banner.label}</span>
                  {data.releaseDate && <span class="ui-label">{data.releaseDate.getFullYear()}</span>}
                </p>
                <h2 class="deed-title">{data.title}</h2>
                {data.description && <p class="deed-desc">{data.description}</p>}
                {data.tags.length > 0 && (
                  <ul class="deed-tags" aria-label="Runes">
                    {data.tags.map((tag) => (
                      <li class="plaque">{tag}</li>
                    ))}
                  </ul>
                )}
                {isExternal ? (
                  <a
                    class="pixel-btn small"
                    href={data.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${data.title} — opens on ${host}`}
                  >
                    Sally forth to {host} ↗
                  </a>
                ) : (
                  <span class="soon">the heralds will announce where it may be played</span>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )}
    <PageFooter updated="1 Sep 2026" />
  </Window>
</BaseLayout>

<style>
  .deeds-header .ui-label {
    margin-top: 0.2rem;
  }

  .deed-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .deed {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem;
    padding: 0.9rem;
    background: var(--parchment-aged);
    border: 2px solid var(--ink);
    box-shadow: inset 2px 2px 0 var(--bevel-dark), inset -2px -2px 0 var(--bevel-light);
  }

  .deed-cover {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 2px solid var(--ink);
    box-shadow: 0 0 0 2px var(--gold);
    image-rendering: pixelated;
  }

  .deed-cover-empty {
    background: var(--stone-dark);
  }

  .deed-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-ui);
  }

  .banner-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 1px 8px;
    border: 1px solid var(--ink);
    color: var(--parchment);
  }

  .banner-tag.done { background: var(--gold); color: var(--ink); }
  .banner-tag.forge { background: var(--ember); animation: newblink 1.4s steps(2, end) infinite; }
  .banner-tag.rumor { background: var(--stone-dark); color: var(--magic); }

  @keyframes newblink {
    50% { opacity: 0.6; }
  }

  .deed-title {
    font-size: var(--text-2xl);
    margin-top: 0.2rem;
  }

  .deed-desc {
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .deed-tags {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .deed-tags .plaque {
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .pixel-btn.small {
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }

  .soon {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  @media (min-width: 48rem) {
    .deed {
      grid-template-columns: 240px 1fr;
      gap: 1.1rem;
    }
  }
</style>
