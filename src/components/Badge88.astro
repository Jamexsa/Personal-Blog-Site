---
/** Heraldic 88×31 mini-banner, drawn entirely in CSS. */
interface Props {
  label: string;
  field?: string;   // background color
  charge?: string;  // text color
  pattern?: 'plain' | 'diaper' | 'paly';
}

const {
  label,
  field = '#1d1733',
  charge = '#e8c558',
  pattern = 'diaper',
} = Astro.props;

const patterns: Record<string, string> = {
  plain: 'none',
  diaper: `repeating-linear-gradient(45deg, rgb(255 255 255 / 0.07) 0 4px, transparent 4px 8px)`,
  paly: `repeating-linear-gradient(90deg, rgb(0 0 0 / 0.18) 0 6px, transparent 6px 12px)`,
};
---

<span class="badge88" style={`--b88-field: ${field}; --b88-charge: ${charge};`}>
  <span class="b88-inner" style={`background-image: ${patterns[pattern]};`}>{label}</span>
</span>

<style>
  .badge88 {
    display: inline-block;
    width: 88px;
    height: 31px;
    padding: 2px;
    background: var(--gold);
    border: 1px solid var(--ink);
    box-shadow: 2px 2px 0 rgb(0 0 0 / 0.4);
    image-rendering: pixelated;
  }

  .b88-inner {
    width: 100%;
    height: 100%;
    background-color: var(--b88-field);
    color: var(--b88-charge);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-ui);
    font-size: 0.62rem;
    line-height: 1.1;
    letter-spacing: 0.04em;
    padding: 0 2px;
    text-transform: uppercase;
  }
</style>
