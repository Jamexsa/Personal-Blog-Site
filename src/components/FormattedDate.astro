---
import { formatDate } from '../lib/posts';

interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<time class="date" datetime={date.toISOString()}>{formatDate(date)}</time>

<style>
  .date {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
