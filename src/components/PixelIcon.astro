---
/**
 * Original pixel glyphs drawn on an 8×8 grid, rendered as crisp SVG rects.
 * Each icon: a color legend + rows of pixels ('.' = transparent).
 */
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

