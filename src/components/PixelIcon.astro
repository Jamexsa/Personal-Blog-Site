      '..XXXX..',
      '.XGGGGX.',
      'XGWGGGGX',
      'XGWGGGGX',
      'XGGGGGGX',
      '.XGGGGX.',
      '..XXXX..',
      '........',
    ],
  },
} as const;

const { name, size = 16, class: className = '' } = Astro.props;
const icon = icons[name];
const legend = icon.colors as Record<string, string>;
const w = icon.grid[0].length;
const h = icon.grid.length;

const pixels: { x: number; y: number; fill: string }[] = [];
icon.grid.forEach((row, y) => {
  [...row].forEach((cell, x) => {
    if (cell !== '.') pixels.push({ x, y, fill: legend[cell] });
  });
});
---

<svg
  class={`pixel-icon ${className}`}
  width={size}
  height={size}
  viewBox={`0 0 ${w} ${h}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
</svg>

<style>
  .pixel-icon {
    image-rendering: pixelated;
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
