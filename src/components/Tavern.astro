---
import Window from './Window.astro';
import PixelIcon from './PixelIcon.astro';
import { navLinks } from './nav-links';

type IconName = Parameters<typeof PixelIcon>[0]['name'];
const sectionIcons: Record<string, IconName> = {
  '/': 'castle',
  '/blog/': 'tome',
  '/games/': 'shield',
  '/art/': 'jester',
  '/about/': 'lute',
};

const sectionTitles: Record<string, string> = {
  '/': 'The Keep',
  '/blog/': 'Grimoire',
  '/games/': 'Deeds',
  '/art/': 'Gallery',
  '/about/': 'The Bard',
};

const currentPath = Astro.url.pathname;
const currentKey =
  navLinks.find(
    ({ href }) => href !== '/' && currentPath.startsWith(href.replace(/\/$/, ''))
  )?.href ?? '/';
---

<Window title="The Tavern" icon="banner" variant="stone" x={16} y={16} width={190} class="tavern">
  <nav aria-label="Sections of the realm">
    <ul>
      {navLinks.map(({ label, href }) => {
        const isActive =
          href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, ''));
        return (
          <li>
            <a href={href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}>
              <PixelIcon name={sectionIcons[href] ?? 'star'} size={14} />
              <span class="tavern-label">{label}</span>
              {isActive && <span class="here" aria-hidden="true">◄</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
  <p class="tavern-note">— {sectionTitles[currentKey]} —</p>
</Window>

<style>
  .tavern ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tavern a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 6px;
    color: var(--parchment);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 1.05rem;
    border: 2px solid transparent;
  }

  .tavern a:hover {
    color: var(--gold-bright);
    border-color: var(--stone-edge);
    background: var(--stone-dark);
  }

  .tavern a.active {
    color: var(--gold-bright);
    background: var(--stone-dark);
    border-color: var(--gold);
  }

  .tavern .here {
    margin-left: auto;
    color: var(--gold-bright);
    font-size: 0.8rem;
  }

  .tavern-note {
    margin-top: 10px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--gold);
  }
</style>
