---
import PixelIcon from './PixelIcon.astro';

type Frame = 'classic' | 'arch' | 'chamfer' | 'scroll' | 'round';
type Trim = 'gold' | 'azurite' | 'verdigris' | 'brazilwood' | 'moon';

interface Props {
  title: string;
  /** short label for the taskbar button (defaults to the full title) */
  shortTitle?: string;
  icon?: Parameters<typeof PixelIcon>[0]['name'];
  /** desktop placement (px) — only applies ≥1024px, stacked below */
  x?: number;
  y?: number;
  width?: number;
  variant?: 'parchment' | 'stone';
  /** corner shape family (M8): classic / arch / chamfer / scroll / round */
  frame?: Frame;
  /** trim color used by corner pieces + title underline */
  trim?: Trim;
  class?: string;
}

const {
  title,
  shortTitle,
  icon,
  x,
  y,
  width,
  variant = 'parchment',
  frame = 'classic',
  trim = 'gold',
  class: className = '',
} = Astro.props;

const winId = (shortTitle ?? title).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const style = [
  x !== undefined && `--win-x: ${x}px`,
  y !== undefined && `--win-y: ${y}px`,
  width !== undefined && `--win-w: ${width}px`,
]
  .filter(Boolean)
  .join('; ');

const placed = x !== undefined ? 'placed' : '';
---

<section
  class:list={['win', variant, frame, placed, className]}
  data-x={x ?? undefined}
  data-trim={trim}
  data-win-id={winId}
  data-short-title={shortTitle ?? title}
  {style}
>
  <header class="win-title" data-drag-handle>
    {icon && <PixelIcon name={icon} size={16} />}
    <span class="win-title-text">{title}</span>
    <span class="seals" aria-hidden="false">
      <button
        class="seal close-seal"
        type="button"
        aria-label={`Close ${shortTitle ?? title}`}
        title={`Close ${shortTitle ?? title}`}
      ></button>
      <span class="seal gold" aria-hidden="true"></span>
    </span>
  </header>
  <div class="win-body">
    <slot />
  </div>
  <span class="corner c-tl" aria-hidden="true"></span>
  <span class="corner c-tr" aria-hidden="true"></span>
  <span class="corner c-bl" aria-hidden="true"></span>
  <span class="corner c-br" aria-hidden="true"></span>
</section>

<style>
  .seals {
    display: inline-flex;
    gap: 4px;
    flex: none;
  }

  .corner {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
    z-index: 2;
  }

  .c-tl { top: -2px; left: -2px; }
  .c-tr { top: -2px; right: -2px; }
  .c-bl { bottom: -2px; left: -2px; }
  .c-br { bottom: -2px; right: -2px; }
</style>
