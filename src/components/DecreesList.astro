---
/**
 * Royal Decrees — the keep's to-do checklist. Toggles persist in
 * localStorage (per browser; no backend, in keeping with the static realm).
 */
const decrees = [
  'hang the reliquary wing (shrines)',
  'raise the radio tower',
  'widen the inn with a proper ledger',
  'sign three guestbooks of allied keeps',
  'sketch one new banner for the exchange',
];
---

<ul class="decrees">
  {decrees.map((text, i) => (
    <li>
      <label>
        <input type="checkbox" data-decree={i} />
        <span class="decree-text">{text}</span>
      </label>
    </li>
  ))}
</ul>
<p class="decrees-note">decrees persist in this browser only — the crown forgets easily.</p>

<style>
  .decrees {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: var(--font-ui);
    font-size: 0.98rem;
  }

  .decrees label {
    display: flex;
    align-items: baseline;
    gap: 9px;
    cursor: pointer;
    color: var(--parchment);
  }

  .decrees input {
    accent-color: var(--gold);
    width: 14px;
    height: 14px;
    flex: none;
    align-self: center;
    cursor: pointer;
  }

  .decrees input:checked + .decree-text {
    text-decoration: line-through;
    opacity: 0.55;
  }

  .decrees-note {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--parchment);
    opacity: 0.8;
  }
</style>

<script>
  const KEY = 'kingdomos-decrees';
  const boxes = document.querySelectorAll<HTMLInputElement>('[data-decree]');

  try {
    const saved = JSON.parse(localStorage.getItem(KEY) ?? '[]') as boolean[];
    boxes.forEach((box, i) => {
      box.checked = saved[i] === true;
    });
  } catch {
    /* fresh ledger */
  }

  boxes.forEach((box) => {
    box.addEventListener('change', () => {
      const state = [...boxes].map((b) => b.checked);
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {
        /* the crown's scribe is asleep */
      }
    });
  });
</script>
