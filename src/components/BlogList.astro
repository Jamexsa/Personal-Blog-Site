---
import FormattedDate from './FormattedDate.astro';
import type { BlogPost } from '../lib/posts';

interface Props {
  posts: BlogPost[];
  /** compact: home-page variant — tighter rows, no excerpt clamp differences */
  compact?: boolean;
}

const { posts, compact = false } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty text-muted">No posts yet — check back soon.</p>
) : (
  <ul class={`post-list ${compact ? 'compact' : ''}`}>
    {posts.map(({ id, data }) => (
      <li>
        <article class="post-row">
          <FormattedDate date={data.pubDate} />
          <div class="post-main">
            <h3 class="post-title">
              <a href={`/blog/${id}/`}>{data.title}</a>
            </h3>
            {data.description && <p class="post-excerpt text-muted">{data.description}</p>}
          </div>
        </article>
      </li>
    ))}
  </ul>
)}

<style>
  .empty {
    padding-block: var(--space-4);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li + li {
    border-top: 1px solid var(--color-line);
  }

  .post-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    padding-block: var(--space-4);
  }

  .post-title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .post-title a {
    color: var(--color-text);
    transition: color 120ms ease;
  }

  .post-title a:hover {
    color: var(--color-accent);
  }

  .post-excerpt {
    font-size: var(--text-sm);
    margin: 0;
    max-width: 65ch;
  }

  /* Tablet and up: date column on the left, title/excerpt on the right */
  @media (min-width: 48rem) {
    .post-row {
      grid-template-columns: 9rem 1fr;
      gap: var(--space-5);
      padding-block: var(--space-5);
    }

    .post-row .date {
      padding-top: var(--space-1);
    }

    .post-title {
      font-size: var(--text-xl);
    }
  }

  /* Compact home variant */
  .compact .post-row {
    padding-block: var(--space-3);
  }

  .compact .post-title {
    font-size: var(--text-base);
  }

  .compact .post-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
