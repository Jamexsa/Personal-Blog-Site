---
import FormattedDate from './FormattedDate.astro';
import type { BlogPost } from '../lib/posts';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty">The grimoire's pages are yet blank — the wizard is brewing entries.</p>
) : (
  <ul class="scroll-list">
    {posts.map(({ id, data }, i) => (
      <li>
        <article class="entry">
          <span class="entry-date">
            <FormattedDate date={data.pubDate} />
            {i === 0 && <span class="new">NEW</span>}
          </span>
          <div class="entry-main">
            <h3 class="entry-title">
              <a href={`/blog/${id}/`}>{data.title}</a>
            </h3>
            {data.description && <p class="entry-desc">{data.description}</p>}
          </div>
        </article>
      </li>
    ))}
  </ul>
)}

<style>
  .empty {
    color: var(--ink-soft);
  }

  .scroll-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .scroll-list li + li {
    border-top: 2px dashed var(--bevel-dark);
    margin-top: 0.4rem;
    padding-top: 0.6rem;
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
  }

  .entry-date {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .new {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--ember);
    color: var(--parchment);
    padding: 0 6px;
    border: 1px solid var(--ink);
    animation: newblink 1.2s steps(2, end) infinite;
  }

  @keyframes newblink {
    50% { opacity: 0.55; }
  }

  .entry-title {
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .entry-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .entry-title a:hover {
    color: var(--ember-deep);
    text-decoration: underline;
  }

  .entry-desc {
    color: var(--ink-soft);
    max-width: 65ch;
  }

  @media (min-width: 48rem) {
    .entry {
      grid-template-columns: 10rem 1fr;
      gap: 1rem;
    }
  }
</style>
