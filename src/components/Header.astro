---
import Nav from './Nav.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/">
      <span class="wordmark-dot" aria-hidden="true"></span>
      YOUR&nbsp;NAME
    </a>

    <Nav class="nav-desktop" />

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-mobile"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav-mobile" id="site-nav-mobile" hidden>
    <div class="container">
      <Nav />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    gap: var(--space-4);
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--color-text);
  }

  .wordmark-dot {
    width: 0.6em;
    height: 0.6em;
    background-color: var(--color-accent);
    border-radius: 50%;
    transition: transform 150ms ease;
  }

  .wordmark:hover .wordmark-dot {
    transform: scale(1.3);
  }

  .nav-desktop {
    display: none;
  }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: var(--space-2);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav-toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background-color: var(--color-text);
    border-radius: var(--radius-sm);
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-mobile {
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-4);
  }

  /* Tablet and up */
  @media (min-width: 48rem) {
    .nav-desktop {
      display: flex;
    }

    .nav-toggle,
    .nav-mobile {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const panel = document.querySelector<HTMLElement>('#site-nav-mobile');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>
