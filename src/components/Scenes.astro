<style>
  /* subjects share placement; everything bottom-anchored like the old castle */
  .subject {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(92vw, 880px);
    height: auto;
    opacity: 0.95;
  }

  .light {
    animation: flicker 3.5s steps(2, end) infinite;
  }

  .light.slow {
    animation-duration: 5.5s;
  }

  @keyframes flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* the big pixel moon + halo */
