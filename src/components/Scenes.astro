      <path d="M143 76 h18 l-9 -22 Z" fill={stone2} />
      <rect x="320" y="76" width="16" height="88" fill={stone} />
      <path d="M319 76 h18 l-9 -22 Z" fill={stone2} />
      <!-- lit windows -->
      <rect x="214" y="78" width="6" height="9" fill={warm} class="light" />
      <rect x="258" y="92" width="6" height="9" fill={goldL} class="light slow" />
      <rect x="160" y="98" width="6" height="9" fill={goldL} />
      <rect x="304" y="98" width="6" height="9" fill={warm} class="light" />
      <rect x="166" y="120" width="6" height="9" fill={goldL} class="light slow" />
      <rect x="298" y="120" width="6" height="9" fill={warm} class="light" />
