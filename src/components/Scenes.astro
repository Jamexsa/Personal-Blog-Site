    </div>
    <svg class="subject" viewBox="0 0 480 190" preserveAspectRatio="xMidYMax meet" shape-rendering="crispEdges">
      <!-- hill -->
      <path d="M0 190 L0 158 L70 136 L150 148 L235 122 L320 138 L400 126 L480 152 L480 190 Z" fill={hill} />
      <!-- trees on the hill -->
      <rect x="92" y="128" width="3" height="12" fill={ink} />
