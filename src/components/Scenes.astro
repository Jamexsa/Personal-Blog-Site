---
/**
 * The eleven subjects of the realm — one pixel-art scene per page.
 * Rendered inside Desktop.astro's wallpaper layer; every scene sits
 * bottom-anchored and center, over the shared night sky.
 *
 * All art original: rect-stepped silhouettes, crispEdges, no bitmaps.
 */
export type SceneName =
  | 'home'
  | 'blog'
  | 'journal'
  | 'games'
  | 'art'
  | 'workspace'
  | 'shrines'
  | 'radio'
  | 'resources'
  | 'guestbook'
  | 'about';

interface Props {
  scene: SceneName;
}

const { scene } = Astro.props;

/* ---------- generated pixel circle rows (for the moons) ---------- */
function moonRows(r: number) {
  const c = r; // viewBox is (2r)x(2r)
  const rows: { y: number; x0: number; w: number }[] = [];
  for (let y = 0; y < 2 * r; y++) {
    const dy = y - c + 0.5;
    const half = Math.sqrt(Math.max(r * r - dy * dy, 0));
    const x0 = Math.round(c - half);
    const x1 = Math.round(c + half);
    if (x1 - x0 > 0) rows.push({ y, x0, w: x1 - x0 });
  }
  return rows;
}

const moon = moonRows(13);
const smallMoon = moonRows(8);

/* craters on the big moon: {x,y,w,h} */
const craters = [
  { x: 12, y: 8, w: 4, h: 3 },
  { x: 17, y: 14, w: 5, h: 4 },
  { x: 8, y: 17, w: 3, h: 2 },
  { x: 19, y: 7, w: 2, h: 2 },
];
/* rim light on the upper-left of the big moon */
const rimLight = [
  { x: 4, y: 8, w: 2, h: 6 },
  { x: 6, y: 6, w: 2, h: 3 },
  { x: 8, y: 4, w: 5, h: 2 },
];

const ink = '#0d0a16';
const stone = '#171130';
const stone2 = '#1e1740';
const hill = '#141021';
const warm = '#ff5a36';
const goldL = '#e8c558';
const teal = '#7fd8c9';
---

