        ))}
        {craters.map((c) => (
          <rect x={c.x} y={c.y} width={c.w} height={c.h} fill="#cbb98f" />
        ))}
        {rimLight.map((c) => (
          <rect x={c.x} y={c.y} width={c.w} height={c.h} fill="#fbf4e0" />
