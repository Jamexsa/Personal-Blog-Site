---
// The kingdom's desktop — a scene engine. Every page gets the shared
// night-sky foundation (dithered bands, dense stars) tinted per scene,
// plus its own subject (Scenes.astro) and signature motes.
import Scenes, { type SceneName } from './Scenes.astro';

interface Props {
  scene?: SceneName;
}

const { scene = 'home' } = Astro.props;

/* per-scene sky tint + signature motes (color / mode / count) */
const sceneCfg: Record<
  SceneName,
  { tint: string; horizon: string; mote: string; moteAlt: string; mode: 'drift' | 'rise' | 'float'; count: number }
> = {
  home:      { tint: '#1a1440', horizon: '#3a2a5e', mote: '#e8c558', moteAlt: '#f4ead0', mode: 'drift',  count: 9 },
  blog:      { tint: '#141a3a', horizon: '#2c3a6e', mote: '#7fe07f', moteAlt: '#e8c558', mode: 'float', count: 8 },
  journal:   { tint: '#241a33', horizon: '#4e3054', mote: '#f4ead0', moteAlt: '#e8c558', mode: 'float', count: 7 },
  games:     { tint: '#2a1626', horizon: '#6e2a1e', mote: '#ff5a36', moteAlt: '#e8c558', mode: 'rise',  count: 8 },
  art:       { tint: '#1f1a44', horizon: '#4a3a7e', mote: '#7fd8c9', moteAlt: '#e9a8d8', mode: 'float', count: 10 },
  workspace: { tint: '#261420', horizon: '#7e3a1e', mote: '#ff5a36', moteAlt: '#e8c558', mode: 'rise',  count: 9 },
  shrines:   { tint: '#1c1440', horizon: '#3e2a6e', mote: '#7fe07f', moteAlt: '#e8c558', mode: 'rise',  count: 8 },
  radio:     { tint: '#12183a', horizon: '#2a3a6e', mote: '#e8c558', moteAlt: '#7fd8c9', mode: 'float', count: 8 },
  resources: { tint: '#161a36', horizon: '#38406e', mote: '#e8c558', moteAlt: '#f4ead0', mode: 'drift', count: 7 },
  guestbook: { tint: '#221a30', horizon: '#5e4030', mote: '#e8c558', moteAlt: '#ff5a36', mode: 'drift', count: 7 },
  about:     { tint: '#1a1438', horizon: '#4e3a5e', mote: '#ff5a36', moteAlt: '#e8c558', mode: 'rise',  count: 8 },
};

const cfg = sceneCfg[scene];
const motes = Array.from({ length: cfg.count }, (_, i) => ({
  left: 6 + ((i * 37) % 88), // spread pseudo-randomly but stable
  top: 52 + ((i * 23) % 38), // lower half of the sky
  delay: (i * 0.9) % 6,
  dur: 6 + ((i * 1.7) % 5),
  alt: i % 3 === 2,
}));
---

<div
  class="wallpaper"
  data-scene={scene}
  style={`--scene-tint: ${cfg.tint}; --scene-horizon: ${cfg.horizon};`}
  aria-hidden="true"
>
  <div class="sky"></div>
  <div class="stars"></div>
  <Scenes {scene} />
  <div class="motes mode-{cfg.mode}">
    {motes.map((m) => (
      <span
        class:list={['mote', { alt: m.alt }]}
        style={`left: ${m.left}%; top: ${m.top}%; animation-delay: ${m.delay}s; --mote-color: ${m.alt ? cfg.moteAlt : cfg.mote}; --mote-dur: ${m.dur}s;`}
      ></span>
    ))}
  </div>
  <div class="mist"></div>
</div>

<div class="desktop-windows">
  <slot />
</div>

<style>
  .wallpaper {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ---------- sky: dithered bands, tinted per scene ---------- */
  .sky {
    position: absolute;
    inset: 0;
    background:
      /* horizon glow */
      linear-gradient(to top, var(--scene-horizon) 0%, transparent 34%),
      /* tint veil */
      linear-gradient(to bottom, var(--scene-tint) 0%, transparent 55%),
      /* the kingdom's night gradient */
      linear-gradient(to bottom, var(--night) 0%, var(--night-deep) 100%);
  }

  /* checkerboard dither edge between the bands (PSX blend) */
  .sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(rgb(0 0 0 / 0.18) 0% 25%, transparent 0% 50%);
    background-size: 4px 4px;
    mask-image: linear-gradient(
      to top,
      transparent 60%,
      rgb(0 0 0 / 0.55) 74%,
      transparent 82%,
      rgb(0 0 0 / 0.3) 90%,
      transparent 96%
    );
  }

  /* ---------- dense star field, three sizes, staggered twinkle ---------- */
  .stars {
    position: absolute;
    inset: 0;
  }

  .stars::before,
  .stars::after {
    content: '';
    position: absolute;
    width: 2px;
    height: 2px;
    background: transparent;
  }

  .stars::before {
    box-shadow:
      4vw 7vh 0 1px #f4ead0, 11vw 3vh 0 0 #cfc6b0, 17vw 13vh 0 1px #f4ead0,
      24vw 5vh 0 0 #f4ead0, 31vw 17vh 0 0 #cfc6b0, 38vw 4vh 0 1px #f4ead0,
      45vw 10vh 0 0 #f4ead0, 52vw 2vh 0 0 #cfc6b0, 58vw 15vh 0 1px #f4ead0,
      65vw 6vh 0 0 #f4ead0, 72vw 12vh 0 0 #cfc6b0, 79vw 4vh 0 1px #f4ead0,
      86vw 16vh 0 0 #f4ead0, 93vw 8vh 0 0 #cfc6b0, 97vw 3vh 0 1px #f4ead0,
      7vw 22vh 0 0 #cfc6b0, 20vw 26vh 0 1px #f4ead0, 35vw 24vh 0 0 #f4ead0,
      53vw 22vh 0 0 #cfc6b0, 71vw 25vh 0 1px #f4ead0, 88vw 21vh 0 0 #f4ead0,
      2vw 32vh 0 0 #cfc6b0, 14vw 34vh 0 0 #f4ead0, 27vw 36vh 0 1px #f4ead0,
      41vw 31vh 0 0 #cfc6b0, 60vw 34vh 0 0 #f4ead0, 76vw 33vh 0 0 #f4ead0,
      95vw 30vh 0 0 #f4ead0, 9vw 42vh 0 1px #cfc6b0, 30vw 44vh 0 0 #f4ead0,
      55vw 43vh 0 0 #f4ead0, 80vw 42vh 0 1px #f4ead0, 6vw 50vh 0 0 #cfc6b0,
      44vw 49vh 0 0 #f4ead0, 68vw 48vh 0 0 #cfc6b0, 91vw 47vh 0 0 #f4ead0;
    animation: twinkle 5s steps(2, end) infinite;
  }

  .stars::after {
    box-shadow:
      8vw 10vh 0 0 #f4ead0, 22vw 8vh 0 1px #e8c558, 33vw 12vh 0 0 #f4ead0,
      47vw 7vh 0 0 #e8c558, 61vw 11vh 0 1px #f4ead0, 74vw 9vh 0 0 #f4ead0,
      89vw 14vh 0 0 #e8c558, 15vw 18vh 0 0 #f4ead0, 39vw 20vh 0 1px #e8c558,
      58vw 19vh 0 0 #f4ead0, 83vw 18vh 0 0 #e8c558, 5vw 28vh 0 1px #f4ead0,
      25vw 30vh 0 0 #e8c558, 49vw 27vh 0 0 #f4ead0, 66vw 29vh 0 1px #e8c558,
      12vw 38vh 0 0 #f4ead0, 36vw 40vh 0 0 #e8c558, 57vw 38vh 0 0 #f4ead0,
      85vw 37vh 0 1px #e8c558, 20vw 46vh 0 0 #f4ead0, 63vw 45vh 0 0 #e8c558,
      93vw 41vh 0 0 #f4ead0;
    animation: twinkle 5s steps(2, end) infinite;
    animation-delay: 2.5s;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* ---------- signature motes ---------- */
  .motes {
    position: absolute;
    inset: 0;
  }

  .mote {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--mote-color, #e8c558);
    box-shadow: 0 0 8px 2px color-mix(in srgb, var(--mote-color, #e8c558) 60%, transparent);
    opacity: 0;
    animation-duration: var(--mote-dur, 7s);
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .motes.mode-drift .mote {
    animation-name: mote-drift;
  }

  .motes.mode-rise .mote {
    animation-name: mote-rise;
    animation-timing-function: ease-in;
  }

  .motes.mode-float .mote {
    animation-name: mote-float;
  }

  @keyframes mote-drift {
    0% { opacity: 0; transform: translate(0, 0); }
    25% { opacity: 0.9; }
    50% { transform: translate(10px, -8px); }
    75% { opacity: 0.7; }
    100% { opacity: 0; transform: translate(-8px, 6px); }
  }

  @keyframes mote-rise {
    0% { opacity: 0; transform: translate(0, 0); }
    15% { opacity: 0.9; }
    100% { opacity: 0; transform: translate(6px, -46vh); }
  }

  @keyframes mote-float {
    0% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 0.8; }
    100% { opacity: 0; transform: translate(-18px, 14px); }
  }

  /* ---------- ground mist with dithered top edge ---------- */
  .mist {
    position: absolute;
    left: -10%;
    bottom: 0;
    width: 120%;
    height: 110px;
    background: linear-gradient(
      to top,
      rgb(157 147 190 / 0.16),
      rgb(157 147 190 / 0.08) 60%,
      transparent
    );
    filter: blur(4px);
    animation: mistdrift 30s linear infinite alternate;
  }

  .mist::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(rgb(13 10 22 / 0.5) 0% 25%, transparent 0% 50%);
    background-size: 3px 3px;
    mask-image: linear-gradient(to top, transparent 30%, black 75%, transparent 100%);
  }

  @keyframes mistdrift {
    from { transform: translateX(-3%); }
    to { transform: translateX(3%); }
  }

  /* windows float above the wallpaper */
  .desktop-windows {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 64rem) {
    .desktop-windows {
      min-height: calc(100vh - var(--statusbar-h));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars::before,
    .stars::after,
    .mote,
    .mist {
      animation: none;
    }

    .mote {
      opacity: 0.5;
    }
  }
</style>

<script>
  // Drag wiring: any .win[data-x] can be moved by its title bar on wide
  // screens; everything stacks and stays put below 1024px.
  const area = document.querySelector('.desktop-windows');

  if (area) {
    const desktopQuery = matchMedia('(min-width: 64rem)');
    let topZ = 5;

    const bringToFront = (win: HTMLElement) => {
      win.style.zIndex = String(++topZ);
    };

    area.querySelectorAll<HTMLElement>('.win').forEach((win) => {
      win.addEventListener('pointerdown', () => bringToFront(win));

      const handle = win.querySelector<HTMLElement>('[data-drag-handle]');
      if (!handle) return;

      handle.addEventListener('pointerdown', (e) => {
        if (!desktopQuery.matches) return;
        if ((e.target as HTMLElement).closest('.seal')) return;
        if (e.button !== 0) return;

        const rect = win.getBoundingClientRect();
        const parent = area.getBoundingClientRect();
        const offX = e.clientX - rect.left;
        const offY = e.clientY - rect.top;
        win.classList.add('dragging');

        const move = (ev: PointerEvent) => {
          const x = Math.min(Math.max(ev.clientX - parent.left - offX, 0), Math.max(parent.width - rect.width, 0));
          const y = Math.min(Math.max(ev.clientY - parent.top - offY, 0), Math.max(parent.height - 40, 0));
          win.style.left = `${x}px`;
          win.style.top = `${y}px`;
        };
        const up = () => {
          win.classList.remove('dragging');
          window.removeEventListener('pointermove', move);
          window.removeEventListener('pointerup', up);
        };

        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
        e.preventDefault();
      });
    });
  }
</script>
