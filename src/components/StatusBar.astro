---
import PixelIcon from './PixelIcon.astro';

/**
 * The taskbar — PSX/CRT edition. Dithered stone chassis, chunky pixel
 * bevels, pressed-in button states, scanlined LCDs with phosphor glow,
 * and a whisper of tube flicker. Left: the Keep button. Middle: window
 * buttons for exactly the current page's windows (Tavern pinned first).
 * Right: where-you-are LCD, guests, live clock.
 */
const year = new Date().getFullYear();

// Where are we? (wing dot color + label)
const wings: [prefix: string, label: string, dot: string][] = [
  ['/', 'The Realm · Castle', '#e8c558'],
  ['/blog', 'Scriptorium · Grimoire', '#7aa7ff'],
  ['/journal', 'Scriptorium · Diary', '#7aa7ff'],
  ['/games', 'Guildhall · Deeds', '#e8c558'],
  ['/art', 'Guildhall · Gallery', '#e8c558'],
  ['/workspace', 'Guildhall · Workshop', '#e8c558'],
  ['/shrines', "Wanderer · Reliquary", '#7fd8c9'],
  ['/radio', 'Wanderer · Radio', '#7fd8c9'],
  ['/resources', 'Wanderer · Stock', '#7fd8c9'],
  ['/guestbook', 'The Inn · Ledger', '#ff7a5a'],
  ['/about', 'The Inn · The Bard', '#ff7a5a'],
];

const currentPath = Astro.url.pathname;
const loc =
  wings.find(([prefix]) => prefix !== '/' && currentPath.startsWith(prefix)) ??
  wings[0];
---

<footer class="statusbar">
  <a class="sb-keep" href="/" title="Return to the Keep">
    <PixelIcon name="castle" size={14} />
    <span class="keep-text">The Keep</span>
  </a>

  <nav class="sb-windows" id="sb-windows" aria-label="Windows on this page"></nav>

  <div class="sb-right">
    <span class="lcd sb-loc" title="Where you are">
      <span class="wing-dot" style={`background: ${loc[2]}`} aria-hidden="true"></span>
      {loc[1]}
    </span>
    <span class="lcd sb-guests" title="Guests of the realm (placeholder counter)">GUESTS: 00427</span>
    <span class="lcd sb-clock" id="sb-clock" title="The realm's hour">--:--</span>
  </div>

  <span class="sb-copy visually-hidden">© {year}</span>
</footer>

<style>
  /* ---------- the chassis: dithered stone with a CRT skin ---------- */
  .statusbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--statusbar-h);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 8px;
    background:
      /* CRT scanlines over the whole bar */
      repeating-linear-gradient(to bottom, transparent 0 2px, rgb(0 0 0 / 0.16) 2px 3px),
      /* checkerboard dither on the stone */
      repeating-conic-gradient(rgb(0 0 0 / 0.18) 0% 25%, transparent 0% 50%),
      linear-gradient(to bottom, var(--stone-dark), #262138 60%, #1c1830);
    background-size: 100% 3px, 4px 4px, 100% 100%;
    border-top: 2px solid var(--ink);
    box-shadow:
      inset 0 2px 0 var(--stone-edge),
      inset 0 3px 0 rgb(0 0 0 / 0.5),
      inset 0 -2px 0 rgb(0 0 0 / 0.6);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--parchment);
    /* the tube breathes, very slightly */
    animation: crt-breathe 9s ease-in-out infinite;
  }

  @keyframes crt-breathe {
    0%, 100% { filter: brightness(1); }
    47% { filter: brightness(1); }
    50% { filter: brightness(1.06); }
    53% { filter: brightness(0.97); }
    56% { filter: brightness(1); }
  }

  /* ---------- the Keep button: an embossed gold-rimmed cartridge ---------- */
  .sb-keep {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    background: linear-gradient(to bottom, #2b2350, var(--indigo) 70%, #16112c);
    border: 2px solid var(--ink);
    box-shadow:
      inset 2px 2px 0 rgb(232 197 88 / 0.35),
      inset -2px -2px 0 rgb(0 0 0 / 0.5),
      2px 2px 0 rgb(0 0 0 / 0.5);
    color: var(--gold-bright);
    text-shadow: 1px 1px 0 rgb(0 0 0 / 0.6);
    text-decoration: none;
    white-space: nowrap;
  }

  .sb-keep:hover {
    background: linear-gradient(to bottom, #3a2f66, #2b2350 70%, #1a1533);
    color: var(--moon);
  }

  .sb-keep:active {
    transform: translate(2px, 2px);
    box-shadow:
      inset 2px 2px 0 rgb(232 197 88 / 0.35),
      inset -2px -2px 0 rgb(0 0 0 / 0.5);
  }

  /* ---------- window buttons: pixel-beveled task cartridges ---------- */
  .sb-windows {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0;
  }

  .sb-windows::-webkit-scrollbar {
    display: none;
  }

  .statusbar :global(.sb-win-btn) {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 170px;
    padding: 3px 9px;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--parchment);
    background: linear-gradient(to bottom, var(--stone), var(--stone-dark) 80%);
    border: 2px solid var(--ink);
    box-shadow:
      inset 2px 2px 0 var(--stone-edge),
      inset -2px -2px 0 rgb(0 0 0 / 0.45),
      2px 2px 0 rgb(0 0 0 / 0.45);
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .statusbar :global(.sb-win-btn::before) {
    content: '▣';
    font-size: 0.75rem;
    color: var(--gold);
    text-shadow: 0 0 5px rgb(232 197 88 / 0.5);
  }

  .statusbar :global(.sb-win-btn:hover) {
    color: var(--gold-bright);
    border-color: var(--gold);
  }

  /* open + topmost: pressed into the bar, gold-lit */
  .statusbar :global(.sb-win-btn.active) {
    color: var(--gold-bright);
    border-color: var(--gold);
    background: linear-gradient(to bottom, #211c36, var(--stone-dark) 60%, #171329);
    box-shadow:
      inset 0 3px 0 var(--gold),
      inset 2px 2px 0 rgb(0 0 0 / 0.5),
      inset -2px -2px 0 rgb(0 0 0 / 0.45);
  }

  /* closed: raised, dimmed, dotted with a ghost marker */
  .statusbar :global(.sb-win-btn.closed) {
    color: var(--stone-edge);
    background: linear-gradient(to bottom, #332e48, #292440);
    box-shadow:
      inset 1px 1px 0 var(--stone-edge),
      inset -1px -1px 0 rgb(0 0 0 / 0.4);
  }

  .statusbar :global(.sb-win-btn.closed::before) {
    content: '▢';
    color: var(--stone-edge);
    text-shadow: none;
  }

  /* the pinned Tavern button carries the wax seal mark */
  .statusbar :global(.sb-win-btn.pinned) {
    border-color: var(--gold);
  }

  .statusbar :global(.sb-win-btn.pinned::before) {
    content: '◉';
    color: var(--ember);
    text-shadow: 0 0 5px rgb(255 90 54 / 0.6);
  }

  /* ---------- LCDs: phosphor panels with their own scanlines ---------- */
  .sb-right {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .sb-clock,
  .sb-guests,
  .sb-loc {
    font-size: 0.85rem;
    padding: 2px 7px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background:
      repeating-linear-gradient(to bottom, transparent 0 2px, rgb(0 0 0 / 0.35) 2px 3px),
      #060410;
    box-shadow:
      inset 2px 2px 0 rgb(0 0 0 / 0.7),
      inset -1px -1px 0 rgb(127 224 127 / 0.15),
      0 0 8px rgb(127 224 127 / 0.12);
    text-shadow: 0 0 6px rgb(127 224 127 / 0.55);
  }

  .wing-dot {
    width: 7px;
    height: 7px;
    flex: none;
    border: 1px solid rgb(0 0 0 / 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .statusbar {
      animation: none;
    }
  }

  @media (max-width: 55rem) {
    .keep-text,
    .sb-loc {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .sb-guests {
      display: none;
    }
  }
</style>

<script>
  const clock = document.querySelector<HTMLElement>('#sb-clock');
  const tick = () => {
    if (!clock) return;
    const now = new Date();
    clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  };
  tick();
  setInterval(tick, 30_000);
</script>
